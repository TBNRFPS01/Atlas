            </div>
          </div>

          <div class="switch"><span></span></div>
        </div>

      </section>

      <!-- VOICE -->
      <section
        class="settings-panel"
        id="voice"
        hidden
      >

        <h2>Voice</h2>

        <div class="setting setting-row">

          <div>
            <div class="setting-title">
              Voice input
            </div>

            <div class="setting-description">
              Talk directly to ATLAS.
            </div>
          </div>

