              Search the web when required.
            </div>
          </div>

          <div class="switch on"><span></span></div>
        </div>

        <div class="setting setting-row">
          <div>
            <div class="setting-title">File Access</div>
            <div class="setting-description">
              Read attached and project files.
            </div>
          </div>

          <div class="switch on"><span></span></div>
        </div>

        <div class="setting setting-row">
          <div>
            <div class="setting-title">Vision</div>
            <div class="setting-description">
              Analyze images and visual input.
            </div>
          </div>

          <div class="switch on"><span></span></div>
        </div>

        <div class="setting setting-row">
          <div>
            <div class="setting-title">System Control</div>
