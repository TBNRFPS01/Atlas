</div>

<!-- SETTINGS -->
<div class="modal-backdrop" id="settingsBackdrop">

  <div class="settings-modal">

    <nav class="settings-nav">

      <button class="active" data-panel="general">
        General
      </button>

      <button data-panel="appearance">
        Appearance
      </button>

      <button data-panel="model">
        Model
      </button>

      <button data-panel="memory">
        Memory
      </button>

      <button data-panel="context">
        Context
      </button>

      <button data-panel="tools">
        Tools
      </button>

      <button data-panel="voice">
        Voice
      </button>

      <button data-panel="data">
        Data & Export
      </button>

      <button data-panel="advanced">
        Advanced
      </button>

    </nav>

    <div class="settings-content">

      <!-- GENERAL -->
      <section class="settings-panel" id="general">

        <h2>General</h2>

        <div class="setting">

          <div class="setting-row">

            <div>
              <div class="setting-title">
                Conversation history
              </div>

              <div class="setting-description">
                Save chats locally.
              </div>
            </div>

            <div class="switch on">
              <span></span>
            </div>

          </div>

        </div>

        <div class="setting">

          <div class="setting-title">
            Keyboard shortcuts
          </div>

          <div class="setting-description">
            Ctrl + K opens the ATLAS command palette.
          </div>

        </div>

      </section>

      <!-- APPEARANCE -->
      <section
        class="settings-panel"
        id="appearance"
        hidden
      >

        <h2>Appearance</h2>

        <div class="setting">

          <div class="setting-title">
            Theme
          </div>

          <div class="setting-description">
            Choose the ATLAS appearance.
          </div>

          <select>
            <option>Ivory Whisper</option>
            <option>Dark ATLAS</option>
            <option>System</option>
          </select>

        </div>

      </section>

      <!-- MODEL -->
      <section
        class="settings-panel"
        id="model"
        hidden
      >

        <h2>Model</h2>

        <div class="setting">

          <div class="setting-title">
            Active model
          </div>

          <div class="setting-description">
            Select the model powering ATLAS.
          </div>

          <select>
            <option>Ministral 3 3B</option>
            <option>Qwen 3 8B</option>
            <option>Gemma</option>
            <option>Llama</option>
          </select>

        </div>

        <div class="setting">

          <div class="setting-title">
            Temperature
          </div>

          <div class="setting-description">
            Controls creativity.
          </div>

          <input
            type="range"
            min="0"
            max="2"
            step=".1"
            value=".7"
          >

        </div>

      </section>

      <!-- MEMORY -->
      <section
        class="settings-panel"
        id="memory"
        hidden
      >

        <h2>Memory</h2>

        <div class="setting">

          <div class="setting-row">

            <div>
              <div class="setting-title">
                Persistent memory
              </div>

              <div class="setting-description">
                Store useful information locally.
              </div>
            </div>

            <div class="switch on">
              <span></span>
            </div>

          </div>

        </div>

        <div class="setting">

          <div class="setting-title">
            Saved memories
          </div>

          <div class="setting-description">
            Review, edit or remove stored context.
