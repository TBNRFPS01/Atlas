              Let ATLAS speak responses.
            </div>
          </div>

          <div class="switch">
            <span></span>
          </div>

        </div>

      </section>

      <!-- DATA -->
      <section
        class="settings-panel"
        id="data"
        hidden
      >

        <h2>Data & Export</h2>

        <div class="setting">

