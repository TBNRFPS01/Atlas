            value="http://localhost:1234/v1"
          >

        </div>

      </section>

    </div>

  </div>

</div>

<div class="toast" id="toast"></div>

<script>

/* =========================================================
   ELEMENTS
========================================================= */

const sidebar =
  document.getElementById("sidebar");

const sidebarBackdrop =
  document.getElementById("sidebarBackdrop");

const openSidebar =
  document.getElementById("openSidebar");

const closeSidebar =
  document.getElementById("closeSidebar");

const welcomeStage =
  document.getElementById("welcomeStage");

const messages =
  document.getElementById("messages");

const messageInput =
  document.getElementById("messageInput");

const sendButton =
  document.getElementById("sendButton");

const stopButton =
  document.getElementById("stopButton");

const chatScroll =
  document.getElementById("chatScroll");

const attachButton =
  document.getElementById("attachButton");

const fileInput =
  document.getElementById("fileInput");

const attachments =
  document.getElementById("attachments");

const voiceButton =
  document.getElementById("voiceButton");

const voiceOverlay =
  document.getElementById("voiceOverlay");

const composerArea =
  document.getElementById("composerArea");

const exitVoice =
  document.getElementById("exitVoice");

const commandPaletteBackdrop =
  document.getElementById("commandPaletteBackdrop");

const commandButton =
  document.getElementById("commandButton");

const commandSearch =
  document.getElementById("commandSearch");

const settingsBackdrop =
  document.getElementById("settingsBackdrop");

const toast =
  document.getElementById("toast");

let generating = false;
let hasStartedChat = false;
let temporaryMode = false;


/* =========================================================
   SIDEBAR
========================================================= */

function showSidebar() {
  sidebar.classList.add("open");
  sidebarBackdrop.classList.add("show");
}

function hideSidebar() {
  sidebar.classList.remove("open");
  sidebarBackdrop.classList.remove("show");
}

openSidebar.addEventListener("click", showSidebar);
closeSidebar.addEventListener("click", hideSidebar);
sidebarBackdrop.addEventListener("click", hideSidebar);


/* =========================================================
   WELCOME -> CHAT TRANSITION
========================================================= */

function beginChat() {

  if (hasStartedChat) return;

  hasStartedChat = true;

  welcomeStage.style.display = "none";

  messages.classList.add("visible");

}


/* =========================================================
   AUTO RESIZE
========================================================= */

messageInput.addEventListener("input", () => {

  messageInput.style.height = "auto";

  messageInput.style.height =
    Math.min(messageInput.scrollHeight, 180) + "px";

});


/* =========================================================
   SEND MESSAGE
========================================================= */

function sendMessage() {

  const text =
    messageInput.value.trim();

  if (!text || generating) return;

  beginChat();

  addMessage("user", text);

  messageInput.value = "";
  messageInput.style.height = "auto";

  scrollToBottom();

  startGeneration();

}

sendButton.addEventListener("click", sendMessage);

messageInput.addEventListener("keydown", event => {

  if (
    event.key === "Enter" &&
    !event.shiftKey
  ) {

    event.preventDefault();

    sendMessage();

  }

});


/* =========================================================
   MESSAGE CREATION
========================================================= */

function escapeHTML(text) {

  const div =
    document.createElement("div");

  div.textContent = text;

  return div.innerHTML;

}

function addMessage(role, text) {

  const message =
    document.createElement("article");

  message.className =
    "message " + role;

  const name =
    role === "assistant"
      ? "ATLAS"
      : "You";

  const avatar =
    role === "assistant"
      ? "A"
      : "U";

  message.innerHTML = `

    <div class="message-avatar">
      ${avatar}
    </div>

    <div class="message-body">

      <div class="message-header">

        <span class="message-name">
          ${name}
        </span>

        <span class="message-meta">
          now
        </span>

      </div>

      <div class="message-content">
        ${escapeHTML(text).replace(/\n/g, "<br>")}
      </div>

      <div class="message-actions">

        <button
          class="message-action copy-message"
          title="Copy"
        >
          â§‰
        </button>

        ${
          role === "user"
          ? `
            <button
              class="message-action edit-message"
              title="Edit"
            >
              âœŽ
            </button>

            <button
              class="message-action branch-message"
              title="Branch conversation"
            >
              ðŸŒ¿
            </button>
          `
          : `
            <button
              class="message-action regenerate-message"
              title="Regenerate"
            >
              â†»
            </button>

            <button
              class="message-action pin-message"
              title="Pin"
            >
              ðŸ“Œ
            </button>

            <button
              class="message-action info-message"
              title="Response info"
            >
              â“˜
            </button>
          `
        }

      </div>

    </div>

  `;

  messages.appendChild(message);

  scrollToBottom();

}


/* =========================================================
   TOOL ACTIVITY
========================================================= */

function addToolActivity() {

  const activity =
    document.createElement("div");

  activity.className =
    "tool-activity";

  activity.innerHTML = `

    <button class="tool-summary">
      <span>
        âŒ„ ATLAS used 3 tools
      </span>

      <span>â€º</span>
    </button>

    <div class="tool-details">

      ðŸ” Searched configured sources<br>
      ðŸ§  Retrieved relevant memory<br>
      ðŸ“ Read project context

    </div>

  `;

  activity
    .querySelector(".tool-summary")
    .addEventListener("click", () => {

      activity.classList.toggle("open");

    });

  messages.appendChild(activity);

}


/* =========================================================
   GENERATION DEMO
========================================================= */

function startGeneration() {

  generating = true;

  sendButton.style.display = "none";
  stopButton.style.display = "grid";

  const loading =
    document.createElement("article");

  loading.className =
    "message assistant loading-message";

  loading.innerHTML = `

    <div class="message-avatar">
      A
    </div>

    <div class="message-body">

      <div class="message-header">

        <span class="message-name">
          ATLAS
        </span>

      </div>

      <div class="message-content">

        Thinking...

      </div>

    </div>

  `;

  messages.appendChild(loading);

  scrollToBottom();

  setTimeout(() => {

    if (!generating) return;

    loading.remove();

    addToolActivity();

    addMessage(
      "assistant",
      "This is where your real ATLAS backend response streams into the interface. The frontend is ready to replace this demo response with router.stream(), memory retrieval, tools, voice, and the rest of your backend pipeline."
    );

    stopGeneration();

  }, 1100);

}

function stopGeneration() {

  generating = false;

  stopButton.style.display = "none";
  sendButton.style.display = "grid";

  const loading =
    document.querySelector(".loading-message");

  if (loading) {
    loading.remove();
  }

}

stopButton.addEventListener("click", () => {

  stopGeneration();

  showToast("Generation stopped");

});


/* =========================================================
   MESSAGE ACTIONS
========================================================= */

document.addEventListener("click", event => {

  const copy =
    event.target.closest(".copy-message");

  if (copy) {

    const message =
      copy.closest(".message");

    const text =
      message
        .querySelector(".message-content")
        .innerText;

    navigator.clipboard.writeText(text);

    showToast("Copied");

  }

});


document.addEventListener("click", event => {

  const edit =
    event.target.closest(".edit-message");

  if (edit) {

    const message =
      edit.closest(".message");

    const content =
      message
        .querySelector(".message-content");

    messageInput.value =
      content.innerText;

    message.remove();

    messageInput.focus();

    messageInput.dispatchEvent(
      new Event("input")
    );

  }

});


document.addEventListener("click", event => {

  const regenerate =
    event.target.closest(".regenerate-message");

  if (
    regenerate &&
    !generating
  ) {

    startGeneration();

  }

});


document.addEventListener("click", event => {

  const pin =
    event.target.closest(".pin-message");

  if (pin) {

    showToast("Message pinned");

  }

});


document.addEventListener("click", event => {

  const branch =
    event.target.closest(".branch-message");

  if (branch) {

    showToast("Conversation branch created");

  }

});


document.addEventListener("click", event => {

  const info =
    event.target.closest(".info-message");

  if (info) {

    showToast(
      "Ministral 3B Â· 42 tok/s Â· 1.2s latency"
    );

  }

});


/* =========================================================
   ATTACHMENTS
========================================================= */

attachButton.addEventListener("click", () => {

  fileInput.click();

});

fileInput.addEventListener("change", () => {

  [...fileInput.files]
    .forEach(file => {

      addAttachment(file.name);

    });

});

function addAttachment(name) {

  const attachment =
    document.createElement("div");

  attachment.className =
    "attachment";

  attachment.innerHTML = `

    ðŸ“Ž
    <span>${escapeHTML(name)}</span>
    <button>âœ•</button>

  `;

  attachment
    .querySelector("button")
    .addEventListener("click", () => {

      attachment.remove();

    });

  attachments.appendChild(attachment);

}


/* =========================================================
   DRAG DROP
========================================================= */

chatScroll.addEventListener("dragover", event => {

  event.preventDefault();

});

chatScroll.addEventListener("drop", event => {

  event.preventDefault();

  [...event.dataTransfer.files]
    .forEach(file => {

      addAttachment(file.name);

    });

  showToast("Files attached");

});


/* =========================================================
   NEW CHAT
========================================================= */

function resetChat() {

  messages.innerHTML = "";

  messages.classList.remove("visible");

  welcomeStage.style.display = "";

  hasStartedChat = false;

  messageInput.value = "";

  temporaryMode = false;

  hideSidebar();

  chatScroll.scrollTop = 0;

  showToast("New conversation");

}

document
  .getElementById("newChat")
  .addEventListener("click", resetChat);


/* =========================================================
   TEMPORARY CHAT
========================================================= */

document
  .getElementById("temporaryChat")
  .addEventListener("click", () => {

    resetChat();

    temporaryMode = true;

    showToast(
      "Temporary chat Â· History and memory disabled"
    );

  });


/* =========================================================
   VOICE MODE
========================================================= */

function enterVoiceMode() {

  voiceOverlay.classList.add("show");

  composerArea.style.display = "none";

}

function leaveVoiceMode() {

  voiceOverlay.classList.remove("show");

  composerArea.style.display = "";

}

voiceButton.addEventListener(
  "click",
  enterVoiceMode
);

exitVoice.addEventListener(
  "click",
  leaveVoiceMode
);

document
  .getElementById("voiceOrb")
  .addEventListener("click", () => {

    leaveVoiceMode();

    messageInput.value =
      "Voice transcription would appear here.";

    messageInput.focus();

    showToast("Voice captured");

  });


/* =========================================================
   COMMAND PALETTE
========================================================= */

function openCommandPalette() {

  commandPaletteBackdrop
    .classList.add("show");

  setTimeout(() => {

    commandSearch.focus();

  }, 50);

}

function closeCommandPalette() {

  commandPaletteBackdrop
    .classList.remove("show");

}

commandButton.addEventListener(
  "click",
  openCommandPalette
);

commandPaletteBackdrop
  .addEventListener("click", event => {

    if (
      event.target ===
      commandPaletteBackdrop
    ) {

      closeCommandPalette();

    }

  });


document
  .querySelectorAll(".command")
  .forEach(command => {

    command.addEventListener("click", () => {

      const action =
        command.dataset.action;

      closeCommandPalette();

      if (action === "new") {
        resetChat();
      }

      if (action === "temporary") {

        resetChat();

        temporaryMode = true;

        showToast(
          "Temporary chat started"
        );

      }

      if (action === "project") {

        showSidebar();

        showToast(
          "Project creation is ready for your backend"
        );

      }

      if (action === "voice") {
        enterVoiceMode();
      }

      if (action === "settings") {
        openSettings();
      }

    });

  });


/* =========================================================
   SETTINGS
========================================================= */

function openSettings() {

  hideSidebar();

  settingsBackdrop
    .classList.add("show");

}

function closeSettings() {

  settingsBackdrop
    .classList.remove("show");

}

document
  .getElementById("settingsButton")
  .addEventListener(
    "click",
    openSettings
  );

document
  .getElementById("openSettings")
  .addEventListener(
    "click",
    openSettings
  );

settingsBackdrop
  .addEventListener("click", event => {

    if (
      event.target ===
      settingsBackdrop
    ) {

      closeSettings();

    }

  });


document
  .querySelectorAll(".settings-nav button")
  .forEach(button => {

    button.addEventListener("click", () => {

      const panel =
        button.dataset.panel;

      document
        .querySelectorAll(
          ".settings-nav button"
        )
        .forEach(btn => {

          btn.classList.remove("active");

        });

      button.classList.add("active");

      document
        .querySelectorAll(
          ".settings-panel"
        )
        .forEach(section => {

          section.hidden =
            section.id !== panel;

        });

    });

  });


/* =========================================================
   SWITCHES
========================================================= */

document
  .querySelectorAll(".switch")
  .forEach(toggle => {

    toggle.addEventListener("click", () => {

      toggle.classList.toggle("on");

    });

  });


/* =========================================================
   SEARCH CHATS
========================================================= */

document
  .getElementById("chatSearch")
  .addEventListener("input", event => {

    const query =
      event.target.value.toLowerCase();

    document
      .querySelectorAll(
        ".history-item, .project"
      )
      .forEach(item => {

        const text =
          item.innerText.toLowerCase();

        item.style.display =
          text.includes(query)
            ? "flex"
            : "none";

      });

  });


/* =========================================================
   EXPORT
========================================================= */

function exportChat() {

  const text =
    [...messages.querySelectorAll(".message")]
      .map(message => {

        const role =
          message.classList.contains("assistant")
            ? "ATLAS"
            : "You";

        const content =
          message
            .querySelector(".message-content")
            ?.innerText || "";

        return `${role}: ${content}`;

      })
      .join("\n\n");

  const blob =
    new Blob(
      [text],
      { type: "text/plain" }
    );

  const url =
    URL.createObjectURL(blob);

  const link =
    document.createElement("a");

  link.href = url;

  link.download =
    "atlas-conversation.txt";

  link.click();

  URL.revokeObjectURL(url);

  showToast("Conversation exported");

}

document
  .getElementById("exportButton")
  .addEventListener(
    "click",
    exportChat
  );

document
  .getElementById("settingsExport")
  .addEventListener(
    "click",
    exportChat
  );


/* =========================================================
   SUGGESTIONS
========================================================= */

document
  .querySelectorAll(".suggestion")
  .forEach(card => {

    card.addEventListener("click", () => {

      messageInput.value =
        card
          .querySelector("strong")
          .innerText;

      messageInput.focus();

    });

  });


/* =========================================================
   SCROLL
========================================================= */

function scrollToBottom() {

  requestAnimationFrame(() => {

    chatScroll.scrollTop =
      chatScroll.scrollHeight;

  });

}


/* =========================================================
   TOAST
========================================================= */

let toastTimer;

function showToast(text) {

  clearTimeout(toastTimer);

  toast.textContent = text;

  toast.classList.add("show");

  toastTimer =
    setTimeout(() => {

      toast.classList.remove("show");

    }, 2200);

}


/* =========================================================
   KEYBOARD SHORTCUTS
========================================================= */

document.addEventListener("keydown", event => {

  if (
    (event.ctrlKey || event.metaKey) &&
    event.key.toLowerCase() === "k"
  ) {

    event.preventDefault();

    openCommandPalette();

  }

  if (event.key === "Escape") {

    hideSidebar();

    closeCommandPalette();

    closeSettings();

    leaveVoiceMode();

  }

});

</script>

</body>
</html>

